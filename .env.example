# ==============================================================================
# OpenClaw CLI Gateway Stack - Environment Configuration
# ==============================================================================

# --- Port Bindings on Host ---
AGY_GATEWAY_PORT=4569
AGY_SEARCH_PORT=4570
LOG_VIEWER_PORT=8765
CLAUDE_GATEWAY_PORT=4568
MUSE_GATEWAY_PORT=4571

# --- Host Path Mounts ---
# Location of your local workspace files
HOST_WORKSPACE_PATH=./workspace

# Location to store stdout/stderr logs locally on host
HOST_LOGS_PATH=./logs

# Host CLI authentication paths (mounts credentials into container)
# Antigravity CLI credentials:
HOST_GEMINI_CONFIG=~/.gemini

# Claude Code login files (optional):
HOST_CLAUDE_CONFIG=~/.claude
HOST_CLAUDE_JSON=~/.claude.json

# Muse Code auth credentials (optional):
HOST_MUSE_AUTH=~/.config/muse/auth.json

# --- Host Antigravity CLI Bridge ---
# Ketika agy berjalan di host machine (macOS) dan gateway di Docker:
USE_HOST_AGY=1
AGY_HOST_DAEMON_PORT=45690
# Path ke binary agy di host (default: ~/.local/bin/agy atau yang ada di PATH)
# AGY_CLI_BIN=~/.local/bin/agy

# --- Service Concurrency & Timeouts ---
AGY_CLI_GATEWAY_MAX_CONCURRENT=6
AGY_CLI_GATEWAY_TIMEOUT_SECONDS=3900

AGY_SEARCH_MAX_CONCURRENT=8
AGY_SEARCH_PORT=4570

CLAUDE_CLI_GATEWAY_MAX_CONCURRENT=6
CLAUDE_CLI_GATEWAY_TIMEOUT_SECONDS=3900
CLAUDE_CLI_GATEWAY_STALL_SECONDS=1200

MUSE_CLI_GATEWAY_MAX_CONCURRENT=2
MUSE_CLI_GATEWAY_TIMEOUT_MS=1800000

# --- Optional Gateway API Keys ---
# Kosongkan jika berjalan di local trusted network (tanpa auth token)
AGY_CLI_GATEWAY_API_KEY=
AGY_SEARCH_API_KEY=
CLAUDE_CLI_GATEWAY_API_KEY=
MUSE_CLI_GATEWAY_API_KEY=

# --- Service Enable Flags (All-in-one container) ---
# Set ke 0 untuk menonaktifkan service yang tidak digunakan
ENABLE_ANTIGRAVITY=1
ENABLE_WEBSEARCH=1
ENABLE_LOG_VIEWER=1
ENABLE_CLAUDE=0
ENABLE_MUSE=0
